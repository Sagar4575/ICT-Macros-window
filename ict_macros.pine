int boxTransparency1 = input.int(85, "Fill transparency", minval = 0, maxval = 100, group = GROUP_W1, tooltip = "0 is opaque and 100 is invisible.")
string borderStyle1 = input.string("Solid", "Border style", options = ["Solid", "Dashed", "Dotted", "None"], group = GROUP_W1, inline = "w1c", tooltip = "Choose a border style, or None for fill only.")
color borderColor1 = input.color(#5b9cf6, "Border color", group = GROUP_W1, inline = "w1c", tooltip = "Independent border color for this window.")
int borderWidth1 = input.int(1, "Border width", minval = 1, maxval = 5, group = GROUP_W1, tooltip = "Box border width in pixels.")
string verticalMode1 = input.string("High-Low of the macro range", "Box vertical mode", options = ["High-Low of the macro range", "Full chart height"], group = GROUP_W1, tooltip = "Use the macro's evolving high-low, or the rolling chart range as a full-pane approximation.")
string extendMode1 = input.string("Until end of macro", "Extend box to the right", options = ["None", "Until end of macro", "Until end of session"], group = GROUP_W1, tooltip = "None follows the active chart bars; Until end of macro projects to the scheduled macro end; Until end of session projects to this window's end time.")
bool showBackground1 = input.bool(false, "Show background", group = GROUP_W1, inline = "w1bg", tooltip = "Shade the chart background during this window's macros, independently of the box.")
color backgroundColor1 = input.color(#5b9cf6, "Background color", group = GROUP_W1, inline = "w1bg", tooltip = "Background shade color for this window.")
int backgroundTransparency1 = input.int(90, "Background transparency", minval = 0, maxval = 100, group = GROUP_W1, tooltip = "0 is opaque and 100 is invisible.")
bool showWindowLabel1 = input.bool(true, "Show label", group = GROUP_W1, inline = "w1l", tooltip = "Show labels for this window when the general label switch is enabled.")
string labelPosition1 = input.string("Top of box", "Label position", options = ["Top of box", "Bottom of box"], group = GROUP_W1, inline = "w1l", tooltip = "Place the label at the macro high or low edge.")
color windowLabelColor1 = input.color(color.new(color.white, 100), "Label text color", group = GROUP_W1, tooltip = "Window-specific label text color; the General color is the fallback if this color is transparent.")

