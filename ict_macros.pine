// --- Time and window helpers ---
formatTwoDigits(int value) =>
    value < 10 ? "0" + str.tostring(value) : str.tostring(value)

formatMacroTime(int stamp, string tz) =>
    formatTwoDigits(hour(stamp, tz)) + ":" + formatTwoDigits(minute(stamp, tz))

windowIncludesCenter(int centerTs, string sessionText, string tz, bool mon, bool tue, bool wed, bool thu, bool fri, bool sat, bool sun) =>
    int startHour = int(str.tonumber(str.substring(sessionText, 0, 2)))
    int startMinute = int(str.tonumber(str.substring(sessionText, 2, 4)))
    int endHour = int(str.tonumber(str.substring(sessionText, 5, 7)))
    int endMinute = int(str.tonumber(str.substring(sessionText, 7, 9)))
    int centerMinute = hour(centerTs, tz) * 60 + minute(centerTs, tz)
    int startMinuteOfDay = startHour * 60 + startMinute
    int endMinuteOfDay = endHour * 60 + endMinute
    bool inTime = startMinuteOfDay == endMinuteOfDay ? true : startMinuteOfDay < endMinuteOfDay ? centerMinute >= startMinuteOfDay and centerMinute <= endMinuteOfDay : centerMinute >= startMinuteOfDay or centerMinute <= endMinuteOfDay
    int centerDay = dayofweek(centerTs, tz)
    bool inDay = switch centerDay
        dayofweek.monday => mon
        dayofweek.tuesday => tue
        dayofweek.wednesday => wed
        dayofweek.thursday => thu
        dayofweek.friday => fri
        dayofweek.saturday => sat
        => sun
    inTime and inDay

// --- Shared macro records; one record is retained per macro and window ---
var array<int> recordCenters = array.new_int()
var array<int> recordWindowIds = array.new_int()
var array<float> recordHighs = array.new_float()
var array<float> recordLows = array.new_float()
var array<box> recordBoxes = array.new_box()
var array<label> recordLabels = array.new_label()

// Find macros using chart-bar overlap; signals are emitted once when a chart bar crosses each boundary.
processWindow(bool enabled, string sessionText, int windowId, bool mon, bool tue, bool wed, bool thu, bool fri, bool sat, bool sun) =>
    bool startedSignal = false
    bool endedSignal = false
    int endedCenter = na
    int candidateCenter = na
    int barEnd = na(time_close) ? time + int(timeframe.in_seconds() * 1000) : time_close
    int localYear = year(time, timezoneInput)
    int localMonth = month(time, timezoneInput)
    int localDay = dayofmonth(time, timezoneInput)
    int localHour = hour(time, timezoneInput)
    int thisHour = timestamp(timezoneInput, localYear, localMonth, localDay, localHour, 0)
    int nextHour = timestamp(timezoneInput, localYear, localMonth, localDay, localHour + 1, 0)
    bool overlapsThis = time < thisHour + 10 * 60 * 1000 and barEnd > thisHour - 10 * 60 * 1000
    bool overlapsNext = time < nextHour + 10 * 60 * 1000 and barEnd > nextHour - 10 * 60 * 1000
    candidateCenter := overlapsThis ? thisHour : overlapsNext ? nextHour : na

    bool qualifiesNow = enabled and not na(candidateCenter) and windowIncludesCenter(candidateCenter, sessionText, timezoneInput, mon, tue, wed, thu, fri, sat, sun)
    bool qualifiesPrevious = enabled and not na(candidateCenter[1]) and windowIncludesCenter(candidateCenter[1], sessionText, timezoneInput, mon, tue, wed, thu, fri, sat, sun)
    if qualifiesNow
        int macroStart = candidateCenter - 10 * 60 * 1000
        int macroEnd = candidateCenter + 10 * 60 * 1000
        startedSignal := time >= macroStart and time < macroEnd and (na(candidateCenter[1]) or candidateCenter[1] != candidateCenter or time[1] < macroStart)

        bool recordFound = false
        if array.size(recordCenters) > 0
            for recordIndex = 0 to array.size(recordCenters) - 1
                if array.get(recordCenters, recordIndex) == candidateCenter and array.get(recordWindowIds, recordIndex) == windowId
                    float updatedHigh = math.max(array.get(recordHighs, recordIndex), high)
                    float updatedLow = math.min(array.get(recordLows, recordIndex), low)
                    array.set(recordHighs, recordIndex, updatedHigh)
                    array.set(recordLows, recordIndex, updatedLow)
                    recordFound := true
        if not recordFound
            array.push(recordCenters, candidateCenter)
            array.push(recordWindowIds, windowId)
            array.push(recordHighs, high)
            array.push(recordLows, low)
            array.push(recordBoxes, na)
            array.push(recordLabels, na)

        // Enforce the total drawing-record cap, removing the oldest macro first.
        while array.size(recordCenters) > maxMacrosInput
            box oldestBox = array.shift(recordBoxes)
            label oldestLabel = array.shift(recordLabels)
            if not na(oldestBox)
                box.delete(oldestBox)
            if not na(oldestLabel)
                label.delete(oldestLabel)
            array.shift(recordCenters)
            array.shift(recordWindowIds)
            array.shift(recordHighs)
            array.shift(recordLows)

    if qualifiesPrevious and time >= candidateCenter[1] + 10 * 60 * 1000 and time[1] < candidateCenter[1] + 10 * 60 * 1000
        endedSignal := true
        endedCenter := candidateCenter[1]
    [startedSignal, endedSignal, endedCenter, candidateCenter]

// --- Chart and drawing helpers ---
bool validTimeframe = timeframe.isintraday and timeframe.in_seconds() >= 60 and timeframe.in_seconds() <= 900
float chartRangeHigh = ta.highest(high, 300)
float chartRangeLow = ta.lowest(low, 300)

getBorderStyle(string choice) =>
    choice == "Dashed" ? line.style_dashed : choice == "Dotted" ? line.style_dotted : line.style_solid

getLabelSize(string choice) =>
    switch choice
        "Tiny" => size.tiny
        "Normal" => size.normal
        "Large" => size.large
        "Huge" => size.huge
        => size.small

windowEndTimestamp(int centerTs, string sessionText, string tz) =>
    int endHour = int(str.tonumber(str.substring(sessionText, 5, 7)))
    int endMinute = int(str.tonumber(str.substring(sessionText, 7, 9)))
    int centerMinuteOfDay = hour(centerTs, tz) * 60 + minute(centerTs, tz)
    int endMinuteOfDay = endHour * 60 + endMinute
    int endDay = dayofmonth(centerTs, tz) + (endMinuteOfDay < centerMinuteOfDay ? 1 : 0)
    timestamp(tz, year(centerTs, tz), month(centerTs, tz), endDay, endHour, endMinute)

// Create or update the drawing record for a macro that overlaps the current bar.
renderWindow(int centerTs, int windowId, string windowName, string sessionText, bool showBox, color fillColor, int fillTransparency, string borderChoice, color borderColor, int borderWidth, string verticalChoice, string extensionChoice, bool showWindowLabel, string labelPosition, color windowTextColor) =>
    int foundIndex = na
    if not na(centerTs) and array.size(recordCenters) > 0
        for recordIndex = 0 to array.size(recordCenters) - 1
            if array.get(recordCenters, recordIndex) == centerTs and array.get(recordWindowIds, recordIndex) == windowId
                foundIndex := recordIndex
    if not na(foundIndex)
        int macroStart = centerTs - 10 * 60 * 1000
        int macroEnd = centerTs + 10 * 60 * 1000
        int currentBarEnd = na(time_close) ? time + int(timeframe.in_seconds() * 1000) : time_close
        int rightEdge = extensionChoice == "Until end of session" ? windowEndTimestamp(centerTs, sessionText, timezoneInput) : extensionChoice == "Until end of macro" ? macroEnd : math.max(macroStart, math.min(currentBarEnd, macroEnd))
        float macroHigh = array.get(recordHighs, foundIndex)
        float macroLow = array.get(recordLows, foundIndex)
        float topPrice = verticalChoice == "Full chart height" ? chartRangeHigh : macroHigh
        float bottomPrice = verticalChoice == "Full chart height" ? chartRangeLow : macroLow
        line_style_placeholder = getBorderStyle(borderChoice)
        color actualBorderColor = borderChoice == "None" ? color.new(borderColor, 100) : borderColor
        box currentBox = array.get(recordBoxes, foundIndex)
        if showBox
            if na(currentBox)
                currentBox := box.new(left = macroStart, top = topPrice, right = rightEdge, bottom = bottomPrice, xloc = xloc.bar_time, border_color = actualBorderColor, border_width = borderWidth, border_style = line_style_placeholder, bgcolor = color.new(fillColor, fillTransparency))
                array.set(recordBoxes, foundIndex, currentBox)
            else
                box.set_left(currentBox, macroStart)
                box.set_right(currentBox, rightEdge)
                box.set_top(currentBox, topPrice)
                box.set_bottom(currentBox, bottomPrice)
                box.set_border_color(currentBox, actualBorderColor)
                box.set_border_width(currentBox, borderWidth)
                box.set_border_style(currentBox, line_style_placeholder)
                box.set_bgcolor(currentBox, color.new(fillColor, fillTransparency))
        else if not na(currentBox)
            box.delete(currentBox)
            array.set(recordBoxes, foundIndex, na)

        color actualTextColor = color.t(windowTextColor) >= 100 ? labelColorInput : windowTextColor
        bool shouldLabel = showLabelsInput and showWindowLabel
        string labelText = windowName + " " + formatMacroTime(macroStart, timezoneInput) + "-" + formatMacroTime(macroEnd, timezoneInput)
        float labelPrice = labelPosition == "Top of box" ? topPrice : bottomPrice
        label currentLabel = array.get(recordLabels, foundIndex)
        if shouldLabel
            if na(currentLabel)
                currentLabel := label.new(x = macroStart, y = labelPrice, text = labelText, xloc = xloc.bar_time, style = labelPosition == "Top of box" ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = actualTextColor, size = getLabelSize(labelSizeInput))
                array.set(recordLabels, foundIndex, currentLabel)
            else
                label.set_x(currentLabel, macroStart)
                label.set_y(currentLabel, labelPrice)
                label.set_text(currentLabel, labelText)
                label.set_style(currentLabel, labelPosition == "Top of box" ? label.style_label_down : label.style_label_up)
                label.set_textcolor(currentLabel, actualTextColor)
                label.set_size(currentLabel, getLabelSize(labelSizeInput))
        else if not na(currentLabel)
            label.delete(currentLabel)
            array.set(recordLabels, foundIndex, na)
    true

// --- Detect each configured window ---
[started1, ended1, endedCenter1, candidate1] = processWindow(enabled1 and validTimeframe, session1, 1, mon1, tue1, wed1, thu1, fri1, sat1, sun1)
[started2, ended2, endedCenter2, candidate2] = processWindow(enabled2 and validTimeframe, session2, 2, mon2, tue2, wed2, thu2, fri2, sat2, sun2)
[started3, ended3, endedCenter3, candidate3] = processWindow(enabled3 and validTimeframe, session3, 3, mon3, tue3, wed3, thu3, fri3, sat3, sun3)
[started4, ended4, endedCenter4, candidate4] = processWindow(enabled4 and validTimeframe, session4, 4, mon4, tue4, wed4, thu4, fri4, sat4, sun4)

if validTimeframe
    renderWindow(candidate1, 1, name1, session1, showBox1, boxFill1, boxTransparency1, borderStyle1, borderColor1, borderWidth1, verticalMode1, extendMode1, showWindowLabel1, labelPosition1, windowLabelColor1)
    renderWindow(candidate2, 2, name2, session2, showBox2, boxFill2, boxTransparency2, borderStyle2, borderColor2, borderWidth2, verticalMode2, extendMode2, showWindowLabel2, labelPosition2, windowLabelColor2)
    renderWindow(candidate3, 3, name3, session3, showBox3, boxFill3, boxTransparency3, borderStyle3, borderColor3, borderWidth3, verticalMode3, extendMode3, showWindowLabel3, labelPosition3, windowLabelColor3)
    renderWindow(candidate4, 4, name4, session4, showBox4, boxFill4, boxTransparency4, borderStyle4, borderColor4, borderWidth4, verticalMode4, extendMode4, showWindowLabel4, labelPosition4, windowLabelColor4)

// Background shading is independent of boxes and labels. On coarse bars, the whole overlapping bar is shaded.
color background1 = validTimeframe and enabled1 and showBackground1 and not na(candidate1) and windowIncludesCenter(candidate1, session1, timezoneInput, mon1, tue1, wed1, thu1, fri1, sat1, sun1) ? color.new(backgroundColor1, backgroundTransparency1) : na
color background2 = validTimeframe and enabled2 and showBackground2 and not na(candidate2) and windowIncludesCenter(candidate2, session2, timezoneInput, mon2, tue2, wed2, thu2, fri2, sat2, sun2) ? color.new(backgroundColor2, backgroundTransparency2) : na
color background3 = validTimeframe and enabled3 and showBackground3 and not na(candidate3) and windowIncludesCenter(candidate3, session3, timezoneInput, mon3, tue3, wed3, thu3, fri3, sat3, sun3) ? color.new(backgroundColor3, backgroundTransparency3) : na
color background4 = validTimeframe and enabled4 and showBackground4 and not na(candidate4) and windowIncludesCenter(candidate4, session4, timezoneInput, mon4, tue4, wed4, thu4, fri4, sat4, sun4) ? color.new(backgroundColor4, backgroundTransparency4) : na
bgcolor(background1, title = "Window 1 macro background")
bgcolor(background2, title = "Window 2 macro background")
bgcolor(background3, title = "Window 3 macro background")
bgcolor(background4, title = "Window 4 macro background")

// Pine cannot query the pane's exact visible price bounds; this warning uses a standard chart label.
var label timeframeWarning = na
if barstate.islast
    if not validTimeframe
        if na(timeframeWarning)
            timeframeWarning := label.new(x = bar_index, y = high, text = "ICT Macro Windows: use an intraday chart from 1 to 15 minutes", xloc = xloc.bar_index, style = label.style_label_down, color = color.new(#f23645, 10), textcolor = color.white, size = size.small)
        else
            label.set_x(timeframeWarning, bar_index)
            label.set_y(timeframeWarning, high)
    else if not na(timeframeWarning)
        label.delete(timeframeWarning)
        timeframeWarning := na

// --- Per-window alertconditions: titles and messages must be compile-time constants in Pine ---
alertcondition(started1, title = "Window 1 Macro started", message = "Window 1 macro started. Use Any alert() function call for the configured name and macro time.")
alertcondition(ended1, title = "Window 1 Macro ended", message = "Window 1 macro ended. Use Any alert() function call for the configured name and macro time.")
alertcondition(started2, title = "Window 2 Macro started", message = "Window 2 macro started. Use Any alert() function call for the configured name and macro time.")
alertcondition(ended2, title = "Window 2 Macro ended", message = "Window 2 macro ended. Use Any alert() function call for the configured name and macro time.")
alertcondition(started3, title = "Window 3 Macro started", message = "Window 3 macro started. Use Any alert() function call for the configured name and macro time.")
alertcondition(ended3, title = "Window 3 Macro ended", message = "Window 3 macro ended. Use Any alert() function call for the configured name and macro time.")
alertcondition(started4, title = "Window 4 Macro started", message = "Window 4 macro started. Use Any alert() function call for the configured name and macro time.")
alertcondition(ended4, title = "Window 4 Macro ended", message = "Window 4 macro ended. Use Any alert() function call for the configured name and macro time.")

// Dynamic alerts include the user-entered window name, local macro times, and timezone.
if started1 and not na(candidate1)
    alert(name1 + " macro started " + formatMacroTime(candidate1 - 10 * 60 * 1000, timezoneInput) + "-" + formatMacroTime(candidate1 + 10 * 60 * 1000, timezoneInput) + " " + timezoneInput, alert.freq_once_per_bar)
if ended1 and not na(endedCenter1)
    alert(name1 + " macro ended " + formatMacroTime(endedCenter1 - 10 * 60 * 1000, timezoneInput) + "-" + formatMacroTime(endedCenter1 + 10 * 60 * 1000, timezoneInput) + " " + timezoneInput, alert.freq_once_per_bar)
if started2 and not na(candidate2)
    alert(name2 + " macro started " + formatMacroTime(candidate2 - 10 * 60 * 1000, timezoneInput) + "-" + formatMacroTime(candidate2 + 10 * 60 * 1000, timezoneInput) + " " + timezoneInput, alert.freq_once_per_bar)
if ended2 and not na(endedCenter2)
    alert(name2 + " macro ended " + formatMacroTime(endedCenter2 - 10 * 60 * 1000, timezoneInput) + "-" + formatMacroTime(endedCenter2 + 10 * 60 * 1000, timezoneInput) + " " + timezoneInput, alert.freq_once_per_bar)
if started3 and not na(candidate3)
    alert(name3 + " macro started " + formatMacroTime(candidate3 - 10 * 60 * 1000, timezoneInput) + "-" + formatMacroTime(candidate3 + 10 * 60 * 1000, timezoneInput) + " " + timezoneInput, alert.freq_once_per_bar)
if ended3 and not na(endedCenter3)
    alert(name3 + " macro ended " + formatMacroTime(endedCenter3 - 10 * 60 * 1000, timezoneInput) + "-" + formatMacroTime(endedCenter3 + 10 * 60 * 1000, timezoneInput) + " " + timezoneInput, alert.freq_once_per_bar)
if started4 and not na(candidate4)
    alert(name4 + " macro started " + formatMacroTime(candidate4 - 10 * 60 * 1000, timezoneInput) + "-" + formatMacroTime(candidate4 + 10 * 60 * 1000, timezoneInput) + " " + timezoneInput, alert.freq_once_per_bar)
if ended4 and not na(endedCenter4)
    alert(name4 + " macro ended " + formatMacroTime(endedCenter4 - 10 * 60 * 1000, timezoneInput) + "-" + formatMacroTime(endedCenter4 + 10 * 60 * 1000, timezoneInput) + " " + timezoneInput, alert.freq_once_per_bar)

plot(na, title = "Hidden helper", display = display.none)