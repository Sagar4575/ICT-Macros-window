indicator("ICT Macro Windows", overlay = true, max_boxes_count = 500, max_labels_count = 500)

// --- Input group names ---
const string GROUP_GENERAL = "General"
const string GROUP_W1 = "Window 1"
const string GROUP_W2 = "Window 2"
const string GROUP_W3 = "Window 3"
const string GROUP_W4 = "Window 4"

// --- General settings ---
string timezoneChoiceInput = input.string("America/New_York", "Timezone", options = ["America/New_York", "Asia/Kolkata", "Europe/London", "UTC", "Custom"], group = GROUP_GENERAL, tooltip = "Choose the timezone used for every window and macro calculation, or select Custom to enter another IANA timezone.")
string customTimezoneInput = input.string("America/New_York", "Custom timezone", group = GROUP_GENERAL, tooltip = "Used only when Timezone is set to Custom. Enter a valid IANA timezone, such as Australia/Sydney.")
string timezoneInput = timezoneChoiceInput == "Custom" ? customTimezoneInput : timezoneChoiceInput
int maxMacrosInput = input.int(50, "Max macros to keep", minval = 1, maxval = 500, group = GROUP_GENERAL, tooltip = "Maximum number of macro drawing records retained across all four windows. Oldest records are deleted first.")
bool showLabelsInput = input.bool(true, "Show labels", group = GROUP_GENERAL, tooltip = "Master switch for all window labels; each window also has its own label switch.")
string labelSizeInput = input.string("Small", "Label text size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = GROUP_GENERAL, tooltip = "Text size applied to all macro labels.")
color labelColorInput = input.color(color.white, "Default label text color", group = GROUP_GENERAL, tooltip = "Fallback label text color. Each window has an independent label color setting.")

